# Vercel Production environment reference. Add real values in Vercel Project
# Settings > Environment Variables. Never commit a populated .env.production.

# Required for the app's built-in HS256 login
DATABASE_URL=
JWT_SECRET=
FRONTEND_URL=https://your-production-domain.example
CRON_SECRET=
ALLOW_INSECURE_AUTH=false

# Optional: only needed when accepting external RS256 tokens. Set all three
# from the identity provider; leave blank for the built-in HS256 login.
JWKS_URI=
AUTH_ISSUER=
AUTH_AUDIENCE=

# Optional app URLs / admin access
APP_URL=https://your-production-domain.example
ADMIN_EMAIL=
ADMIN_EMAILS=
ADMIN_PASSWORD=
NEXT_PUBLIC_REGISTER_URL=https://your-production-domain.example/register
NEXT_PUBLIC_GOOGLE_AUTH_URL=
NEXT_PUBLIC_APPLE_AUTH_URL=
NEXT_PUBLIC_STORE_PICKUP_ADDRESS=
LOW_STOCK_THRESHOLD=10

# Transactional email (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Card payments (only configure if Stripe is enabled)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Product comparison AI; keep the key server-side
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Shipping / tracking (only configure if enabled)
DEFAULT_CARRIER=
TRACKING_API_URL=
TRACKING_API_KEY=

# Multicaixa
MULTICAIXA_API_URL=
MULTICAIXA_SECRET_KEY=
MULTICAIXA_MERCHANT_ID=
MULTICAIXA_ENVIRONMENT=production
MULTICAIXA_PUBLIC_WEBHOOK_URL=https://your-production-domain.example/api/payments/webhook
MULTICAIXA_TIMEOUT_MS=10000
MULTICAIXA_EXPIRATION_MINUTES=30
