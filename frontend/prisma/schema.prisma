// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Market {
  PT
  AO
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  promotionCategories PromotionCategory[]
}

model Brand {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  slug      String     @unique
  products  Product[]
  promotionBrands PromotionBrand[]
}

model Supplier {
  id          Int      @id @default(autoincrement())
  name        String
  contactName String?
  email       String?
  phone       String?
  taxId       String?
  country     String   @default("Angola")
  province    String?
  city        String?
  address     String?
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([country, taxId])
  @@index([name])
  @@index([active])
}

model Product {
  id          Int        @id @default(autoincrement())
  name        String
  slug        String     @unique
  description String?
  basePrice   Decimal    @db.Decimal(10,2)
  imageUrl    String?
  stock       Int        @default(0)
  weightGrams Int        @default(650)
  lengthCm    Decimal?   @db.Decimal(8,2)
  widthCm     Decimal?   @db.Decimal(8,2)
  heightCm    Decimal?   @db.Decimal(8,2)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  categoryId  Int
  category    Category   @relation(fields: [categoryId], references: [id])
  brandId     Int
  brand       Brand      @relation(fields: [brandId], references: [id])
  prices      Price[]
  quoteItems  QuoteItem[]
  attributes  ProductAttribute[]
  promotionProducts PromotionProduct[]
  b2bPriceRules B2BPriceRule[]
  favorites UserFavorite[]
  reviews ProductReview[]
}

model UserFavorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@index([productId])
}

model ProductReview {
  id               Int      @id @default(autoincrement())
  productId        Int
  userId           Int
  orderId          Int
  rating           Int
  title            String?
  comment          String
  status           String   @default("PENDING")
  verifiedPurchase Boolean  @default(true)
  helpfulCount     Int      @default(0)
  moderatedBy      String?
  moderatedAt      DateTime?
  moderationNote   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@unique([userId, productId])
  @@index([productId, status, createdAt])
  @@index([userId, createdAt])
  @@index([orderId])
}

model ProductAttribute {
  id        Int      @id @default(autoincrement())
  productId Int
  name      String
  value     String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([name, value])
  @@unique([productId, name, value])
}

model Price {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  market    Market
  currency  String
  amount    Decimal  @db.Decimal(10,2)
  createdAt DateTime @default(now())
}

model Company {
  id Int @id @default(autoincrement())
  legalName String
  tradeName String?
  nif String @unique
  email String?
  phone String?
  country String @default("Angola")
  province String?
  city String?
  address String?
  status String @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users User[]
  members CompanyMember[]
  quotes Quote[]
  orders Order[]
  priceRules B2BPriceRule[]
  purchaseOrders PurchaseOrder[]
  invitations B2BInvitation[]
  invoices Invoice[]
  creditNotes CreditNote[]
  @@index([status])
}

model B2BInvitation {
  id Int @id @default(autoincrement())
  companyId Int
  email String
  role String @default("BUYER")
  status String @default("PENDING")
  tokenHash String @unique
  invitedByUserId Int
  acceptedByUserId Int?
  expiresAt DateTime
  acceptedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy User @relation("B2BInvitationSender", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  acceptedBy User? @relation("B2BInvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  @@index([companyId, status, expiresAt])
  @@index([email, status, expiresAt])
  @@index([companyId, email])
}

model CompanyMember {
  id Int @id @default(autoincrement())
  companyId Int
  userId Int
  role String @default("BUYER")
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([companyId, userId])
  @@index([userId, status])
}

model B2BPriceRule {
  id Int @id @default(autoincrement())
  companyId Int
  productId Int
  minQuantity Int @default(1)
  unitPrice Decimal @db.Decimal(12,2)
  currency String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([companyId, productId, minQuantity])
  @@index([companyId, productId, active])
}

model PurchaseOrder {
  id Int @id @default(autoincrement())
  companyId Int
  quoteId Int?
  orderId Int?
  poNumber String @unique
  status String @default("DRAFT")
  approvedBy Int?
  approvedAt DateTime?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quote Quote? @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  @@index([companyId, status])
}

model User {
  id           Int      @id @default(autoincrement())
  externalId   String   @unique
  email        String?  @unique
  name         String?
  provider     String?
  accountName  String   @default("Conta Retalhista")
  accountType  String   @default("B2C")
  accessRole   String   @default("CUSTOMER")
  status       String   @default("ACTIVE")
  stripeCustomerId String? @unique
  b2bRequestStatus String @default("NONE")
  companyId Int?
  companyDocumentPath String?
  personalDocumentPath String?
  passwordHash String?
  lastLoginAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]
  quotes       Quote[]
  returnRequests ReturnRequest[]
  payments     Payment[]
  passwordResetTokens PasswordResetToken[]
  addresses       Address[]
  savedPaymentMethods SavedPaymentMethod[]
  coupons         UserCoupon[]
  promotionUsages PromotionUsage[]
  securitySessions SecuritySession[]
  twoFactorAuth TwoFactorAuth?
  recoveryCodes TwoFactorRecoveryCode[]
  securityEvents SecurityEvent[]
  communicationPreference CommunicationPreference?
  notifications Notification[]
  refunds Refund[]
  supportConversations SupportConversation[] @relation("SupportCustomer")
  assignedSupportConversations SupportConversation[] @relation("SupportAgent")
  supportMessages SupportMessage[]
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyMemberships CompanyMember[]
  b2bInvitationsSent B2BInvitation[] @relation("B2BInvitationSender")
  b2bInvitationsAccepted B2BInvitation[] @relation("B2BInvitationAcceptor")
  invoices Invoice[]
  creditNotes CreditNote[]
  favorites UserFavorite[]
  reviewsWritten ProductReview[]
}

model Address {
  id         Int      @id @default(autoincrement())
  userId     Int
  label      String
  recipient  String
  phone      String
  country    String   @default("Angola")
  province   String
  city       String
  address    String
  postalCode String?
  notes      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, isDefault])
}

model SavedPaymentMethod {
  id          Int      @id @default(autoincrement())
  userId      Int
  type        String
  label       String
  lastFour    String?
  phoneNumber String?
  providerToken String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, isDefault])
}

model Coupon {
  id             Int         @id @default(autoincrement())
  code           String      @unique
  description    String
  discountType   String
  discountValue  Decimal     @db.Decimal(10,2)
  minimumOrderKZ Decimal?    @db.Decimal(12,2)
  expiresAt      DateTime?
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now())
  users          UserCoupon[]
}

model UserCoupon {
  userId   Int
  couponId Int
  claimedAt DateTime @default(now())
  usedAt   DateTime?
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon   Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  @@id([userId, couponId])
  @@index([couponId])
}

model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id           Int      @id @default(autoincrement())
  name         String
  location     String
  text         String
  stars        Int      @default(5)
  published    Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model Order {
  id             Int         @id @default(autoincrement())
  orderNumber    String      @unique
  idempotencyKey String?     @unique
  status         String      @default("PROCESSING")
  userId         Int
  user           User        @relation(fields: [userId], references: [id])
  deliveryMode   String
  shippingMethod String
  paymentMethod  String
  country        Market
  currency       String
  billingName    String?
  billingEmail   String?
  billingTaxId   String?
  deliveryRecipient String?
  deliveryCity   String?
  deliveryRegion String?
  postalCode     String?
  deliveryNotes  String?
  address        String?
  phone          String?
  carrier        String?
  trackingNumber String?
  totalEUR       Decimal     @db.Decimal(10,2)
  totalKZ        Decimal     @db.Decimal(12,2)
  createdAt      DateTime    @default(now())
  inventoryReserved Boolean  @default(false)
  inventoryReservationExpiresAt DateTime?
  items          OrderItem[]
  productReviews ProductReview[]
  payment        Payment?
  trackingEvents TrackingEvent[]
  returnRequests ReturnRequest[]
  refunds Refund[]
  discounts      OrderDiscount[]
  promotionUsages PromotionUsage[]
  companyId Int?
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  purchaseOrders PurchaseOrder[]
  discountTotalEUR Decimal @default(0) @db.Decimal(10,2)
  discountTotalKZ  Decimal @default(0) @db.Decimal(12,2)
  invoice Invoice?
  creditNotes CreditNote[]
}

model Invoice {
  id                Int      @id @default(autoincrement())
  invoiceNumber     String   @unique
  verificationCode  String   @unique
  orderId           Int      @unique
  userId            Int
  companyId         Int?
  status            String   @default("ISSUED")
  currency          String
  totalEUR          Decimal  @db.Decimal(10,2)
  totalKZ           Decimal  @db.Decimal(12,2)
  discountTotalEUR  Decimal  @default(0) @db.Decimal(10,2)
  discountTotalKZ   Decimal  @default(0) @db.Decimal(12,2)
  sellerName        String
  sellerTaxId       String?
  sellerAddress     String?
  buyerName         String?
  buyerEmail        String?
  buyerTaxId        String?
  buyerAddress      String?
  issuedBy          String
  issuedAt          DateTime @default(now())
  voidedAt          DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  company           Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  creditNotes       CreditNote[]
  @@index([companyId, issuedAt])
  @@index([userId, issuedAt])
  @@index([status, issuedAt])
}

model CreditNote {
  id               Int      @id @default(autoincrement())
  creditNoteNumber String   @unique
  verificationCode String   @unique
  invoiceId        Int
  orderId          Int
  refundId         Int      @unique
  userId           Int
  companyId        Int?
  status           String   @default("ISSUED")
  currency         String
  amountEUR        Decimal  @db.Decimal(10,2)
  amountKZ         Decimal  @db.Decimal(12,2)
  reason           String
  sellerName       String
  sellerTaxId      String?
  sellerAddress    String?
  buyerName        String?
  buyerTaxId       String?
  buyerAddress     String?
  issuedBy         String
  issuedAt         DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  invoice          Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refund           Refund   @relation(fields: [refundId], references: [id], onDelete: Restrict)
  user             User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  company          Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  @@index([companyId, issuedAt])
  @@index([userId, issuedAt])
  @@index([invoiceId, issuedAt])
}


model SystemSetting {
  id             String   @id @default("global")
  vatEnabled     Boolean  @default(false)
  vatRate        Decimal? @db.Decimal(5,2)
  vatIncluded    Boolean  @default(true)
  vatConfiguredAt DateTime?
  vatConfiguredBy String?
  updatedAt      DateTime @updatedAt
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  name      String
  slug      String
  imageUrl  String?
  unitPrice Decimal  @db.Decimal(10,2)
  quantity  Int
  subtotal  Decimal  @db.Decimal(12,2)
}

model Payment {
  id        Int      @id @default(autoincrement())
  orderId   Int      @unique
  userId    Int
  provider  String
  method    String
  status    String   @default("PENDING")
  providerPaymentId String? @unique
  reference String?
  entity    String?
  referenceNumber String?
  expiresAt DateTime?
  phoneNumber String?
  currency  String   @default("AOA")
  amountEUR Decimal   @db.Decimal(10,2)
  amountKZ  Decimal   @db.Decimal(12,2)
  paidAt    DateTime?
  failedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
  attempts  PaymentAttempt[]
  events    PaymentEvent[]
  refunds   Refund[]
}

model PaymentAttempt {
  id                Int      @id @default(autoincrement())
  paymentId         Int
  idempotencyKey    String   @unique
  providerPaymentId String?
  status            String   @default("CREATED")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  payment           Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  @@index([paymentId])
}

model PaymentEvent {
  id              Int      @id @default(autoincrement())
  paymentId       Int?
  providerEventId String   @unique
  eventType       String
  status          String
  amountKZ        Decimal? @db.Decimal(12,2)
  currency        String?
  payload         Json
  processedAt     DateTime?
  createdAt       DateTime  @default(now())
  payment         Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  @@index([paymentId])
}

model TrackingEvent {
  id          Int      @id @default(autoincrement())
  orderId     Int
  status      String
  location    String?
  description String?
  occurredAt  DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Quote {
  id          Int      @id @default(autoincrement())
  quoteNumber String   @unique
  userId      Int
  status      String   @default("SUBMITTED")
  companyName String
  companyNif  String
  address     String?
  sector      String?
  phone       String
  email       String
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
  companyId   Int?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  items       QuoteItem[]
  purchaseOrders PurchaseOrder[]
}

model QuoteItem {
  id        Int      @id @default(autoincrement())
  quoteId   Int
  productId Int
  name      String
  unitPrice Decimal  @db.Decimal(10,2)
  quantity  Int
  subtotal  Decimal  @db.Decimal(12,2)
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])
}

model ReturnRequest {
  id            Int      @id @default(autoincrement())
  requestNumber String   @unique
  orderId       Int
  userId         Int
  type          String
  status        String   @default("RECEIVED")
  reason        String
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  order         Order    @relation(fields: [orderId], references: [id])
  user          User     @relation(fields: [userId], references: [id])
  events        ReturnRequestEvent[]
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model ReturnRequestEvent {
  id              Int      @id @default(autoincrement())
  returnRequestId Int
  previousStatus  String?
  nextStatus      String
  actorExternalId String
  note            String?
  createdAt       DateTime @default(now())
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  @@index([returnRequestId, createdAt])
}


model Promotion {
  id                  Int      @id @default(autoincrement())
  name                String
  slug                String   @unique
  description         String?
  code                String?  @unique
  status              String   @default("DRAFT")
  startAt             DateTime
  endAt               DateTime?
  priority            Int      @default(0)
  stackable           Boolean  @default(false)
  exclusive           Boolean  @default(false)
  usageLimit          Int?
  perCustomerLimit    Int?
  minOrderAOA         Decimal? @db.Decimal(12,2)
  minOrderEUR         Decimal? @db.Decimal(10,2)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  rules               PromotionRule[]
  actions             PromotionAction[]
  products            PromotionProduct[]
  categories          PromotionCategory[]
  brands              PromotionBrand[]
  usages              PromotionUsage[]
  orderDiscounts      OrderDiscount[]
  @@index([status, active, startAt, endAt])
  @@index([priority])
}

model PromotionRule {
  id          Int       @id @default(autoincrement())
  promotionId Int
  kind        String
  operator    String    @default("EQ")
  value       String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  @@index([promotionId, kind])
}

model PromotionAction {
  id             Int       @id @default(autoincrement())
  promotionId    Int
  type           String
  value          Decimal?  @db.Decimal(12,2)
  maxDiscount    Decimal?  @db.Decimal(12,2)
  promotion      Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  @@index([promotionId])
}

model PromotionProduct {
  promotionId Int
  productId   Int
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@id([promotionId, productId])
  @@index([productId])
}

model PromotionCategory {
  promotionId Int
  categoryId  Int
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  @@id([promotionId, categoryId])
  @@index([categoryId])
}

model PromotionBrand {
  promotionId Int
  brandId     Int
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  brand       Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  @@id([promotionId, brandId])
  @@index([brandId])
}

model PromotionUsage {
  id             Int       @id @default(autoincrement())
  promotionId    Int
  userId         Int
  orderId        Int
  couponCode     String?
  discountAmount Decimal   @db.Decimal(12,2)
  currency       String
  createdAt      DateTime  @default(now())
  promotion      Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id])
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@unique([promotionId, orderId])
  @@index([promotionId, userId])
}

model OrderDiscount {
  id             Int       @id @default(autoincrement())
  orderId        Int
  promotionId    Int?
  promotionName  String
  code           String?
  type           String
  amount         Decimal   @db.Decimal(12,2)
  currency       String
  metadata       Json?
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  promotion      Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  @@index([orderId])
  @@index([promotionId])
}

model FinanceEntry {
  id              Int                 @id @default(autoincrement())
  type            String
  description     String
  category        String
  amount          Decimal             @db.Decimal(12,2)
  currency        String              @default("AOA")
  status          String              @default("CONFIRMED")
  transactionDate DateTime            @default(now())
  reference       String?
  notes           String?
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  events          FinanceEntryEvent[]
  @@index([type, status, transactionDate])
  @@index([category])
}

model FinanceEntryEvent {
  id               Int         @id @default(autoincrement())
  entryId          Int
  actorExternalId  String?
  eventType        String
  payload          Json
  createdAt         DateTime    @default(now())
  entry            FinanceEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  @@index([entryId, createdAt])
}

model SecuritySession {
  id Int @id @default(autoincrement())
  userId Int
  tokenHash String @unique
  deviceName String
  browser String
  operatingSystem String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  lastActivityAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  events SecurityEvent[]
  @@index([userId, lastActivityAt])
}

model TwoFactorAuth {
  id Int @id @default(autoincrement())
  userId Int @unique
  secretEncrypted String
  enabled Boolean @default(false)
  verifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TwoFactorRecoveryCode {
  id Int @id @default(autoincrement())
  userId Int
  codeHash String @unique
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, usedAt])
}

model SecurityEvent {
  id Int @id @default(autoincrement())
  userId Int
  sessionId Int?
  type String
  status String
  ipAddress String?
  userAgent String?
  metadata Json @default("{}")
  dedupeKey String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  session SecuritySession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@unique([userId, dedupeKey])
}

model CommunicationPreference {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  promotions   Boolean  @default(true)
  newProducts  Boolean  @default(false)
  orderUpdates Boolean  @default(true)
  commercialUpdates Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  title     String
  message   String
  link      String?
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([type, createdAt])
}

model Refund {
  id               Int      @id @default(autoincrement())
  orderId          Int
  paymentId        Int
  userId           Int
  amountEUR        Decimal  @db.Decimal(10,2)
  amountKZ         Decimal  @db.Decimal(12,2)
  currency         String
  reason           String
  status           String   @default("REQUESTED")
  providerRefundId String?  @unique
  idempotencyKey   String?  @unique
  provider         String
  requestedBy      String?
  processedBy      String?
  failureReason    String?
  createdAt        DateTime @default(now())
  processedAt      DateTime?
  order            Order   @relation(fields: [orderId], references: [id])
  payment          Payment @relation(fields: [paymentId], references: [id])
  user             User    @relation(fields: [userId], references: [id])
  creditNote       CreditNote?
  @@index([orderId, createdAt])
  @@index([paymentId, status])
  @@index([userId, createdAt])
}


model SupportConversation {
  id          Int       @id @default(autoincrement())
  customerId  Int?
  guestName   String?
  guestEmail  String?
  guestSessionHash String?
  agentId     Int?
  status      String    @default("OPEN")
  subject     String?
  lastMessageAt DateTime @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  customer    User?     @relation("SupportCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  agent       User?     @relation("SupportAgent", fields: [agentId], references: [id], onDelete: SetNull)
  messages    SupportMessage[]
  @@index([customerId, status, updatedAt])
  @@index([guestSessionHash, status, updatedAt])
  @@index([agentId, status, updatedAt])
  @@index([status, lastMessageAt])
}

model SupportMessage {
  id             Int      @id @default(autoincrement())
  conversationId Int
  senderId       Int?
  senderRole     String
  content        String
  createdAt      DateTime @default(now())
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User? @relation(fields: [senderId], references: [id], onDelete: SetNull)
  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}
