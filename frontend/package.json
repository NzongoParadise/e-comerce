    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "prisma": "^5.19.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
